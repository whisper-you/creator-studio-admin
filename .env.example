# 前端请求后端 API 的基础路径 (开发模式留空默认走 Vite 代理，独立部署时可填如 http://localhost:5180)
VITE_API_BASE=

# 后端服务端口 (开发模式默认 5180，Docker/生产模式默认 3000)
API_PORT=5180

# JWT 鉴权密钥
# - 开发环境可留空,自动回退到内置开发密钥
# - 生产环境必填:至少 32 位随机字符串,可用 `openssl rand -hex 32` 生成
JWT_SECRET=

# 会话有效期
# access token 默认 15 分钟;refresh token 默认 30 天(HttpOnly Cookie,生产强制 Secure,需 HTTPS)
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# 生产环境空库首次启动的管理员账号 (必须成对设置,密码至少 8 位)
# 已有数据库时可省略
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=管理员

# 是否注入演示数据 (文章/素材/评论与默认口令演示账号)
# 默认:开发/测试 true,生产 false。生产环境开启仅用于演示部署
# SEED_DEMO_DATA=false

# 是否允许用户自助切换角色 (演示用)。默认:非生产环境开启,生产环境关闭
# ALLOW_ROLE_SWITCH=true

# 跨域白名单 (逗号分隔)。默认:开发/测试放行本地 Vite,生产仅同源
# 前后端同源部署或使用 Vite 代理时无需配置;前端独立域名部署时才需要
# CORS_ORIGINS=https://admin.example.com

# 反向代理层数 (例如 Nginx 后设为 1),用于限流按真实客户端 IP 计数
# 默认 false:直连部署不要开启,否则 X-Forwarded-For 可被伪造
# TRUST_PROXY=1

# 认证端点限流 (单进程内存计数,重启清零)
# 默认:登录 30 次/15 分钟,注册 5 次/小时,改密 10 次/15 分钟,刷新 120 次/15 分钟
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# REGISTER_RATE_LIMIT_MAX=5
# REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# CHANGE_PASSWORD_RATE_LIMIT_MAX=10
# REFRESH_RATE_LIMIT_MAX=120

